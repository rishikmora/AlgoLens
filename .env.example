# Copy to .env.local and restart the dev server.

# Optional. Without it, the tutor and interviewer run on the built-in
# deterministic engine (still useful, just not model-generated), and the
# whiteboard vision feature reports that it is unavailable.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5
