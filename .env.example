# Copy to .env.local and restart the dev server.

# ── Supabase (auth + user data) ────────────────────────────────────
# Find these in Supabase → Project Settings → API.
# The publishable key is meant to be public; RLS is what protects rows.
# Without these the app still runs, storing progress in localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Anthropic (optional) ───────────────────────────────────────────
# Without a key, the tutor and interviewer use the built-in deterministic
# engine, and whiteboard vision reports that it is unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
